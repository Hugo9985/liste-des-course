rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(gid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
    }

    match /users/{u} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == u;
    }

    match /groups/{gid} {
      allow get: if signedIn();                                   // nécessaire pour rejoindre par nom
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        // rejoindre : on ne peut que s'ajouter soi-même
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)));
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /items/{id} {
        allow read, update, delete: if isMember(gid);
        allow create: if isMember(gid) && request.resource.data.authorId == request.auth.uid;
      }
    }
  }
}
